# Control plane
DATABASE_URL=postgresql+psycopg://agentrt:agentrt@127.0.0.1:5432/agentrt
PORT=8841
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=10
SEED_DEMO=true
SEED_SALES_ROWS=20000
MIGRATE_ON_START=true

# Read-only sales connection injected into the harness, never into the executor.
SALES_DATABASE_URL=postgresql+psycopg://sales_ro:sales_ro@127.0.0.1:5432/sales
# Used only by the dataset loader. Not mounted into run pods.
SALES_ADMIN_URL=postgresql+psycopg://agentrt:agentrt@127.0.0.1:5432/sales

# fake | openai
LLM_MODE=fake
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
# Optional JSON map of AgentSpec model.class -> {base_url, model, api_key_env}
# LLM_MODEL_CLASSES={"local-default":{"base_url":"http://127.0.0.1:11434/v1","model":"qwen2.5-coder:7b","api_key_env":"LLM_API_KEY"},"cloud-strong":{"base_url":"https://api.openai.com/v1","model":"gpt-4.1","api_key_env":"LLM_API_KEY_CLOUD"}}

# local | kubernetes
RUN_BACKEND=local
CONTROL_PLANE_PUBLIC_URL=http://127.0.0.1:8841
CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:8841
IMAGE_REGISTRY=
RUNTIME_IMAGE=agent-runtime-py312:0.2.0
RUN_NAMESPACE=agent-runs
JOB_TTL_SECONDS=600

# pvc | s3. pvc writes ARTIFACT_DIR. On OpenShift that path is the control-plane PVC.
# ARTIFACT_BACKEND=local is an alias of pvc when ARTIFACT_STORE is unset.
ARTIFACT_STORE=pvc
ARTIFACT_DIR=var/artifacts
ARTIFACT_RETENTION_DAYS=14
ARTIFACT_MAX_BYTES=20000000
S3_ENDPOINT_URL=http://127.0.0.1:8833
S3_BUCKET=agent-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Empty URL means the tool is mocked and audited. Tokens stay on the control plane.
EMAIL_API_URL=
EMAIL_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
HTTP_TOOL_BASE_URL=
HTTP_TOOL_TOKEN=
EMAIL_RECIPIENT_ALLOWLIST=finans@sirket.local,*@sirket.local

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-runtime
LOG_LEVEL=INFO

SQL_STATEMENT_TIMEOUT_MS=30000
SQL_MAX_LIMIT=2000000
SQL_MAX_COST=10000000
ARROW_BATCH_ROWS=10000
LLM_MAX_PREVIEW_ROWS=200
